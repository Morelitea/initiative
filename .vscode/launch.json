{
  "version": "0.2.0",
  "configurations": [
    {
      // The whole dev flow behind one button: dev:setup brings up Postgres,
      // migrates, seeds, and starts Vite (which opens the browser), then this
      // session runs the API itself so backend breakpoints work. Stopping the
      // session runs dev:cleanup — servers down, seeded data removed. Works in
      // any worktree: every part of the chain resolves its own ports.
      "name": "Dev Environment",
      "type": "debugpy",
      "request": "launch",
      // Runs uvicorn in-process rather than as a module, because this file
      // cannot run a shell to find out which port a linked worktree was
      // allocated. The launcher asks scripts/dev-ports.sh and starts the same
      // server, so breakpoints behave identically and every worktree's debug
      // session lands on its own port.
      "program": "${workspaceFolder}/backend/scripts/dev_api.py",
      "cwd": "${workspaceFolder}/backend",
      "python": "${workspaceFolder}/backend/.venv/bin/python",
      "console": "integratedTerminal",
      // Step into FastAPI/SQLModel frames too — most of what goes wrong here
      // surfaces inside the framework rather than in app code.
      "justMyCode": false,
      "preLaunchTask": "dev:setup",
      "postDebugTask": "dev:cleanup"
    },
    {
      // Same flow without the debugger attached, for when the terminal script
      // is what you want (it is also what the Zed task runs).
      "name": "Dev Environment (no debugger)",
      "type": "node-terminal",
      "request": "launch",
      "command": "bash ${workspaceFolder}/scripts/dev-pre-launch.sh",
      "cwd": "${workspaceFolder}"
    }
  ]
}
