// The widths are Tailwind's sm: … xl:, set in styles.css. A media or
// container query on a width is refused: use the variants.
language css

CssAtRule() as $rule where {
  $rule <: r"(?s)@(?:media|container)[^{]*width.*",
  register_diagnostic(
    span=$rule,
    message="Only sm:, md:, lg: and xl: set a width: use them (or canvas-sm: … for a region) instead of a width query. See the widths in styles.css.",
    severity="error"
  )
}
