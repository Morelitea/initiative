{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rootDir": "electron/src",
    "outDir": "electron/dist",
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["electron/src"],
  "exclude": ["electron/src/**/*.test.mts"]
}
